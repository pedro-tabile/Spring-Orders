# Chave de segurança para geração de token JWT
JWT_SECURITY_KEY=<senha-seguranca>

# Configurações (senha e usuário) do banco de dados
MYSQL_USER=<user>
MYSQL_ROOT_PASSWORD=<123456>

# Token de API do MailerSend com permissão para envio de email
MAILERSEND_API_TOKEN=<mlsn.xxxxxxx>
# Token do MailerSend para template de email (pode ser o mesmo usado para envio de email; depende da configuração)
TEMPLATE_TOKEN=<mlsn.xxxxxxx>
# Id do template de email
TEMPLATE_ID_HTML=<xxxxxxxx>
# Endereço de email gerado pelo MailerSend
ADDRESS_EMAIL=<MS_xxxxxxxxx>

# Token da API do Google AI Studio para LLM
TOKEN_API_GOOGLE_GENAI=<AQ.xxxxxxx>
# Token da API da Groq para STT
TOKEN_API_GROQ_STT=<gsk_xxxxxx>